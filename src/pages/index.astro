---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const database = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(database),
  getAllCategories(database),
  getAllPublishers(database),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700/50 bg-slate-800/60 p-6" data-testid="game-filters">
            <fieldset>
              <legend class="mb-4 text-lg font-medium text-slate-100">Filter games</legend>
              <div class="grid gap-6 md:grid-cols-2">
                <div>
                  <span class="mb-2 block text-sm font-medium text-slate-200">Categories</span>
                  <div class="grid gap-2" data-testid="category-filters">
                    {categories.map((category) => (
                      <label class="flex items-center gap-2 text-sm text-slate-300">
                        <input
                          type="checkbox"
                          value={category.id}
                          class="rounded border-slate-600 bg-slate-700 text-blue-500 focus:ring-2 focus:ring-blue-500"
                          data-testid={`category-filter-${category.id}`}
                        />
                        <span>{category.name}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div>
                  <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
                  <select
                    id="publisher-filter"
                    class="w-full rounded border border-slate-600 bg-slate-700 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid="publisher-filter"
                  >
                    <option value="">All publishers</option>
                    {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                  </select>
                </div>
              </div>
              <p class="mt-4 text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-result-count">
                Showing {games.length} {games.length === 1 ? 'game' : 'games'}
              </p>
            </fieldset>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filter-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const categoryFilters = Array.from(document.querySelectorAll<HTMLInputElement>('[data-testid^="category-filter-"]'));

  if (filterForm && resultCount && emptyState && publisherFilter) {
    const updateFilters = (): void => {
      const selectedCategories = categoryFilters
        .filter((categoryFilter) => categoryFilter.checked)
        .map((categoryFilter) => categoryFilter.value);
      const selectedPublisher = publisherFilter.value;
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryMatches =
          selectedCategories.length === 0 ||
          selectedCategories.includes(card.dataset.categoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const isVisible = categoryMatches && publisherMatches;

        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      }

      resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
      emptyState.classList.toggle('hidden', visibleCount !== 0);
    };

    filterForm.addEventListener('change', updateFilters);
  }
</script>
